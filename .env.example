# Copy to .env, which compose.yaml reads automatically:
#
#   cp .env.example .env
#
# MODEL_DIR and MODEL_FILE have no defaults on purpose -- compose refuses to
# start without them rather than guessing at a model path.

# Directory on this machine holding your .gguf files. Mounted read-only.
MODEL_DIR=/home/you/.local/share/gobbonet/models

# The chat model, by filename inside MODEL_DIR.
MODEL_FILE=your-model.Q4_K_M.gguf

# The engine. CPU by default. Swap for a GPU build -- server-cuda, server-rocm,
# server-vulkan, server-intel, server-musa, server-openvino -- and uncomment the
# matching devices block in compose.yaml, or the card sits idle.
# Append -bNNNN (e.g. server-cuda-b9010) to pin a build.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Layers to offload to the GPU. 0 is CPU-only; 99 means "all of them", which is
# what you want on a card the model fits in.
GPU_LAYERS=0

# Context window, and the KV cache quantisation used to hold it: f16, q8_0 or
# q4_0. These are the same knobs the settings panel writes to perf.toml, so pick
# what the card can hold -- too large and the model fails to load.
CTX_SIZE=16384
KV_CACHE_TYPE=q8_0

# Host port for the chat screen. The container always listens on 9066.
LISTEN_PORT=9066
